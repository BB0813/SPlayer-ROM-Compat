<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/enhanced_notification_root"
  android:layout_width="match_parent"
  android:layout_height="72dp"
  android:background="@drawable/bg_enhanced_notification"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="12dp"
  android:paddingTop="8dp"
  android:paddingEnd="8dp"
  android:paddingBottom="8dp">

  <ImageView
    android:id="@+id/enhanced_notification_cover"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="@drawable/bg_enhanced_notification_cover"
    android:contentDescription="@string/enhanced_notification_cover"
    android:scaleType="centerCrop" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="10dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_weight="1">

    <TextView
      android:id="@+id/enhanced_notification_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFFFFFFF"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/enhanced_notification_subtitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#B3FFFFFF"
      android:textSize="12sp" />

    <ProgressBar
      android:id="@+id/enhanced_notification_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="3dp"
      android:layout_marginTop="6dp"
      android:max="1000"
      android:progressDrawable="@drawable/bg_enhanced_notification_progress" />
  </LinearLayout>

  <ImageButton
    android:id="@+id/enhanced_notification_previous"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/notification_action_previous"
    android:padding="8dp"
    android:scaleType="center"
    android:src="@drawable/ic_notify_previous" />

  <ImageButton
    android:id="@+id/enhanced_notification_seek_backward"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/notification_action_seek_backward"
    android:padding="8dp"
    android:scaleType="center"
    android:src="@drawable/ic_notify_seek_backward" />

  <ImageButton
    android:id="@+id/enhanced_notification_play_pause"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="@drawable/bg_enhanced_notification_button"
    android:contentDescription="@string/playback_notification_play_pause"
    android:padding="9dp"
    android:scaleType="center" />

  <ImageButton
    android:id="@+id/enhanced_notification_seek_forward"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/notification_action_seek_forward"
    android:padding="8dp"
    android:scaleType="center"
    android:src="@drawable/ic_notify_seek_forward" />

  <ImageButton
    android:id="@+id/enhanced_notification_next"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/notification_action_next"
    android:padding="8dp"
    android:scaleType="center"
    android:src="@drawable/ic_notify_next" />
</LinearLayout>
